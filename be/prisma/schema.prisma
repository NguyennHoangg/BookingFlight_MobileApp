

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum Role {
  USER
  ADMIN
}

enum MembershipTier {
  MEMBER
  SILVER
  GOLD
  PLATINUM
}

enum FlightStatus {
  SCHEDULED // Đúng giờ
  DELAYED   // Hoãn chuyến
  CANCELLED // Đã hủy
  COMPLETED // Đã hạ cánh
}

enum SeatClass {
  ECONOMY   // Phổ thông
  BUSINESS  // Thương gia
}

enum SeatType {
  WINDOW    // Ghế cửa sổ (A, F)
  MIDDLE    // Ghế giữa (B, E)
  AISLE     // Ghế lối đi (C, D)
  EXIT_ROW  // Hàng ghế thoát hiểm (chỗ để chân rộng)
}

enum PassengerType {
  ADULT     // Người lớn (>= 12 tuổi)
  CHILD     // Trẻ em (2 - 11 tuổi)
  INFANT    // Em bé (< 2 tuổi)
}

enum FlightDirection {
  OUTBOUND  // Chuyến đi
  INBOUND   // Chuyến về (khứ hồi)
}

enum BookingStatus {
  PENDING   // Đang chờ thanh toán
  CONFIRMED // Đã thanh toán thành công
  CANCELLED // Đã hủy / Hết hạn giữ chỗ
}

enum PaymentMethod {
  VNPAY
  PAYOS
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENTAGE   // Giảm theo %
  FIXED_AMOUNT // Giảm số tiền cố định
}

enum ServiceType {
  BAGGAGE   // Hành lý ký gửi mua thêm
  MEAL      // Suất ăn trên máy bay
  INSURANCE // Bảo hiểm trễ chuyến / du lịch
  LOUNGE    // Phòng chờ thương gia
}

enum BaggageStatus {
  CHECKED_IN // Đã nhận tại quầy làm thủ tục
  LOADED     // Đã chất lên khoang máy bay
  ARRIVED    // Đã ra băng chuyền sân bay đến
}

enum RefundStatus {
  PENDING   // Chờ xử lý
  APPROVED  // Đã duyệt hoàn vé
  REJECTED  // Từ chối
  COMPLETED // Đã hoàn tiền về tài khoản khách
}

// ============================================================================
// 2. CÁC BẢNG DỮ LIỆU CHÍNH (20 MODELS)
// ============================================================================

// Bảng 1: Người dùng (Tài khoản đăng nhập App)
model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  fullName       String
  phone          String         @unique
  avatarUrl      String?
  loyaltyPoints  Int            @default(0)
  membershipTier MembershipTier @default(MEMBER)
  role           Role           @default(USER)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  savedPassengers SavedPassenger[]
  userCoupons     UserCoupon[]
  bookings        Booking[]
  notifications   Notification[]
}

// Bảng 2: Danh bạ hành khách lưu sẵn (Điền nhanh khi đặt vé)
model SavedPassenger {
  id             String        @id @default(uuid())
  userId         String
  fullName       String        // VD: NGUYEN VAN A
  passengerType  PassengerType @default(ADULT)
  dateOfBirth    DateTime
  identityNumber String?       // Số CCCD hoặc Hộ chiếu
  isActive       Boolean       @default(true)

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Bảng 3: Sân bay (VD: SGN - Tân Sơn Nhất, HAN - Nội Bài)
model Airport {
  id               String   @id @default(uuid())
  code             String   @unique // Mã IATA 3 ký tự: SGN, HAN, DAD, PQC...
  name             String
  city             String
  country          String   @default("Việt Nam")
  isActive         Boolean  @default(true)

  departingFlights Flight[] @relation("DepartureAirport")
  arrivingFlights  Flight[] @relation("ArrivalAirport")
}

// Bảng 4: Hãng hàng không (Vietnam Airlines, Vietjet Air, Bamboo Airways)
model Airline {
  id                String             @id @default(uuid())
  code              String             @unique // Mã IATA 2 ký tự: VN, VJ, QH
  name              String
  logoUrl           String
  isActive          Boolean            @default(true)

  aircrafts         Aircraft[]
  fareClasses       FareClass[]
  flights           Flight[]
  ancillaryServices AncillaryService[]
}

// Bảng 5: Đội tàu bay
model Aircraft {
  id               String         @id @default(uuid())
  airlineId        String
  registrationCode String         @unique // Số hiệu đăng bạ: VN-A861, VJ-A642
  model            String         // Dòng máy bay: Airbus A321neo, Boeing 787-10
  seatLayout       String         @default("3-3") // Cấu hình cột ghế: "3-3" hoặc "2-4-2"
  totalSeats       Int            @default(180)
  isActive         Boolean        @default(true)

  airline          Airline        @relation(fields: [airlineId], references: [id])
  seatTemplates    SeatTemplate[]
  flights          Flight[]
}

// Bảng 6: Sơ đồ ghế mẫu chuẩn của tàu bay
model SeatTemplate {
  id                String    @id @default(uuid())
  aircraftId        String
  seatNumber        String    // "1A", "1B", ..., "30F"
  rowNumber         Int
  columnLetter      String    // "A", "B", "C", "D", "E", "F"
  seatClass         SeatClass @default(ECONOMY)
  seatType          SeatType  @default(MIDDLE)
  defaultExtraPrice Int       @default(0) // Phụ phí chọn ghế mặc định
  isActive          Boolean   @default(true)

  aircraft          Aircraft  @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([aircraftId, seatNumber])
}

// Bảng 7: Hạng vé & Điều kiện hoàn đổi (Eco, Deluxe, SkyBoss/Business)
model FareClass {
  id             String                @id @default(uuid())
  airlineId      String
  name           String                // "Eco", "Deluxe", "Business"
  carryOnBaggage Int                   @default(7)     // Số kg hành lý xách tay
  checkedBaggage Int                   @default(0)     // Số kg hành lý ký gửi miễn phí đi kèm
  isRefundable   Boolean               @default(false) // Có được phép hoàn hủy vé không?
  changeFee      Int                   @default(350000)// Phí đổi giờ/ngày bay (VNĐ)
  isActive       Boolean               @default(true)

  airline        Airline               @relation(fields: [airlineId], references: [id])
  inventories    FlightFareInventory[]
  tickets        Ticket[]
}

// Bảng 8: Chuyến bay
model Flight {
  id                 String                @id @default(uuid())
  flightNumber       String                // Số hiệu: VN214, VJ122
  airlineId          String
  aircraftId         String
  departureAirportId String
  arrivalAirportId   String
  departureTime      DateTime
  arrivalTime        DateTime
  terminal           String                @default("T1")  // Nhà ga T1 / T2
  gate               String                @default("G05") // Cổng ra máy bay
  basePrice          Int                   // Giá cơ bản (VNĐ)
  status             FlightStatus          @default(SCHEDULED)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())

  airline            Airline               @relation(fields: [airlineId], references: [id])
  aircraft           Aircraft              @relation(fields: [aircraftId], references: [id])
  departureAirport   Airport               @relation("DepartureAirport", fields: [departureAirportId], references: [id])
  arrivalAirport     Airport               @relation("ArrivalAirport", fields: [arrivalAirportId], references: [id])

  seats              FlightSeat[]
  fareInventories    FlightFareInventory[]
  tickets            Ticket[]

  // Đánh Index giúp truy vấn tìm kiếm chuyến bay nhanh
  @@index([departureAirportId, arrivalAirportId, departureTime])
}

// Bảng 9: Quỹ vé và giá bán theo từng hạng của chuyến bay
model FlightFareInventory {
  id          String    @id @default(uuid())
  flightId    String
  fareClassId String
  price       Int       // Giá bán của hạng vé này trên chuyến bay
  totalQuota  Int       // Tổng số chỗ mở bán cho hạng vé này
  soldCount   Int       @default(0) // Số chỗ đã bán
  isActive    Boolean   @default(true)

  flight      Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  fareClass   FareClass @relation(fields: [fareClassId], references: [id])

  @@unique([flightId, fareClassId])
}

// Bảng 10: Sơ đồ ghế thực tế trên từng chuyến bay (Chống trùng ghế)
model FlightSeat {
  id            String    @id @default(uuid())
  flightId      String
  seatNumber    String    // "12A", "12B"...
  seatClass     SeatClass @default(ECONOMY)
  seatType      SeatType  @default(MIDDLE)
  priceModifier Int       @default(0)     // Phụ phí chọn vị trí ghế này
  isBooked      Boolean   @default(false) // true = Đã có người đặt
  lockedUntil   DateTime?                 // Khóa ghế tạm thời 10 phút khi chờ thanh toán
  isActive      Boolean   @default(true)

  flight        Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  ticket        Ticket?

  @@unique([flightId, seatNumber])
}

// Bảng 11: Chương trình Khuyến mãi / Mã giảm giá
model Promotion {
  id                String       @id @default(uuid())
  code              String       @unique // VD: "SUMMER2026", "VNPAY50K"
  title             String
  description       String
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Int          // VD: 15 (nếu giảm 15%) hoặc 50000 (nếu giảm 50k)
  maxDiscountAmount Int          // Giảm tối đa (VNĐ)
  minOrderValue     Int          @default(0)
  startDate         DateTime
  expiryDate        DateTime
  totalQuantity     Int          @default(500)
  claimedCount      Int          @default(0)
  usedCount         Int          @default(0)
  isActive          Boolean      @default(true)

  userCoupons       UserCoupon[]
  bookings          Booking[]
}

// Bảng 12: Ví Coupon cá nhân của người dùng
model UserCoupon {
  id          String    @id @default(uuid())
  userId      String
  promotionId String
  isUsed      Boolean   @default(false)
  isActive    Boolean   @default(true)
  claimedAt   DateTime  @default(now())
  usedAt      DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  booking     Booking?

  @@unique([userId, promotionId])
}

// Bảng 13: Đơn đặt chỗ tổng (Booking - Chứa mã đặt chỗ PNR 6 ký tự)
model Booking {
  id             String               @id @default(uuid())
  pnrCode        String               @unique // Mã PNR 6 ký tự: "VN839X"
  userId         String
  promotionId    String?
  userCouponId   String?              @unique
  isRoundTrip    Boolean              @default(false)
  subTotal       Int                  // Tổng tiền vé + ghế + dịch vụ trước giảm giá
  taxAndFees     Int                  // Thuế và phí sân bay
  discountAmount Int                  @default(0)
  totalAmount    Int                  // Số tiền thực trả cuối cùng
  status         BookingStatus        @default(PENDING)
  contactName    String
  contactEmail   String
  contactPhone   String
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user           User                 @relation(fields: [userId], references: [id])
  promotion      Promotion?           @relation(fields: [promotionId], references: [id])
  userCoupon     UserCoupon?          @relation(fields: [userCouponId], references: [id])
  tickets        Ticket[]
  payment        Payment?
  refundRequest  RefundCancelRequest?
}

// Bảng 14: Vé điện tử của từng hành khách (Ticket / Boarding Pass)
model Ticket {
  id                  String          @id @default(uuid())
  ticketNumber        String          @unique // Số vé điện tử 13 chữ số IATA: "738-2938401928"
  bookingId           String
  flightId            String
  flightSeatId        String          @unique // Mỗi vé gắn chặt với 1 ghế duy nhất
  fareClassId         String
  direction           FlightDirection @default(OUTBOUND)
  passengerName       String          // Họ tên in hoa không dấu: NGUYEN VAN A
  passengerType       PassengerType   @default(ADULT)
  dateOfBirth         DateTime?
  identityNumber      String?         // Số CCCD / Passport
  frequentFlyerNumber String?         // Số thẻ Bông Sen Vàng / Hội viên hãng bay
  ticketPrice         Int             // Giá thành phần của riêng vé này
  isCheckedIn         Boolean         @default(false)
  boardingTime        DateTime?       // Giờ lên máy bay (trước giờ bay 30-45 phút)
  qrCodeData          String          // Chuỗi dữ liệu mã hóa để vẽ mã QR trên Boarding Pass
  isActive            Boolean         @default(true)

  booking             Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  flight              Flight          @relation(fields: [flightId], references: [id])
  seat                FlightSeat      @relation(fields: [flightSeatId], references: [id])
  fareClass           FareClass       @relation(fields: [fareClassId], references: [id])
  addons              TicketAddon[]
  luggage             LuggageCheckIn?
}

// Bảng 15: Danh mục dịch vụ mua thêm (Hành lý ký gửi, Suất ăn, Bảo hiểm)
model AncillaryService {
  id          String        @id @default(uuid())
  airlineId   String
  type        ServiceType
  name        String        // VD: "Gói hành lý 20kg", "Cơm gà sốt tiêu đen"
  price       Int
  isActive    Boolean       @default(true)

  airline     Airline       @relation(fields: [airlineId], references: [id])
  addons      TicketAddon[]
}

// Bảng 16: Chi tiết dịch vụ hành khách đã mua kèm theo vé
model TicketAddon {
  id             String           @id @default(uuid())
  ticketId       String
  serviceId      String
  quantity       Int              @default(1)
  priceAtBooking Int
  isActive       Boolean          @default(true)

  ticket         Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  service        AncillaryService @relation(fields: [serviceId], references: [id])
}

// Bảng 17: Quản lý thẻ hành lý ký gửi tại sân bay (Baggage Tag)
model LuggageCheckIn {
  id             String        @id @default(uuid())
  ticketId       String        @unique
  baggageTagCode String        @unique // Mã vạch dán lên vali: "VN-0839201"
  weightKg       Float         // Cân nặng thực tế (kg)
  status         BaggageStatus @default(CHECKED_IN)
  isActive       Boolean       @default(true)
  updatedAt      DateTime      @updatedAt

  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// Bảng 18: Lịch sử giao dịch thanh toán (VNPay / PayOS)
model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  paymentMethod   PaymentMethod @default(VNPAY)
  transactionCode String?       // Mã giao dịch trả về từ cổng thanh toán
  amount          Int
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// Bảng 19: Yêu cầu Hoàn / Hủy vé
model RefundCancelRequest {
  id           String       @id @default(uuid())
  bookingId    String       @unique
  reason       String
  penaltyFee   Int          // Phí phạt hoàn hủy theo FareClass
  refundAmount Int          // Số tiền thực nhận lại
  status       RefundStatus @default(PENDING)
  isActive     Boolean      @default(true)
  requestedAt  DateTime     @default(now())
  processedAt  DateTime?

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// Bảng 20: Thông báo trong ứng dụng (Màn hình Notifications)
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}