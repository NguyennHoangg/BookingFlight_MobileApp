{
  "expo": {
    "name": "SkyJourney",
    "slug": "flight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Splash_icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.anonymous.BookingFlight"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/app_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.BookingFlight"
    },
    "web": {
      "favicon": "./assets/app_icon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-router",
      "expo-sharing"
    ],
    "scheme": "skyjourney",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c526b761-84f1-49a7-8a85-21b442182a70"
      }
    },
    "owner": "minhkiet05"
  }
}
